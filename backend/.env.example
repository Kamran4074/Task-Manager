# Server
PORT=5000
NODE_ENV=production

# Database - use MongoDB Atlas connection string for hosting
# Format: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/<dbname>
MONGODB_URI=mongodb://localhost:27017/webapp

# JWT - use a long random string in production (min 32 chars)
JWT_SECRET=change_this_to_a_long_random_secret_string

# CORS - set to your frontend URL in production
CLIENT_URL=http://localhost:5173
